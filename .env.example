# Desarrollo local. Copia este archivo como .env si quieres personalizarlo.
DEBUG=true
SECRET_KEY=
POSTGRES_PASSWORD=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Sin DATABASE_URL se utiliza SQLite en local.
# DATABASE_URL=postgresql://entrelineas:password@localhost:5432/entrelineas
# En local los enlaces de verificación aparecen en la terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Entrelíneas <noreply@localhost>
# Opcional: solicitar acceso en https://boktyven.no/api. Solo se envía desde el servidor.
BOKTYVEN_API_TOKEN=
REGISTRATION_OPEN=false
